# =========================================================================
# SmartBin IoT System - Git Ignore Configuration
# Covers Node.js backend, React+Vite frontend, ESP8266/ESP32 firmware, and simulation
# =========================================================================

# --- Dependencies ---
node_modules/
*/node_modules/
.pnp/
.pnp.js
.yarn/cache
.yarn/unplugged
.yarn/build-state.yml
.yarn/install-state.gz
.pnpm-store/

# --- Environment Variables & Sensitive Credentials ---
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
*.env
*.env.*
!*.env.example

# Hardware & Firmware private credentials (Wi-Fi passwords, private endpoints)
# Never commit config.h containing real access credentials; use config.example.h
firmware/config.h
firmware/**/config.h
!firmware/config.example.h
!firmware/**/config.example.h

# --- Build & Distribution Outputs ---
dist/
*/dist/
build/
*/build/
out/
.vite/
*/.vite/
.cache/

# --- Microcontroller & Embedded Firmware Binaries ---
# Compiled binaries, ELF executables, memory maps generated by arduino-cli
*.bin
*.elf
*.hex
*.map
*.merged.bin
*.partitions.bin
*.bootloader.bin
*.ino.bin
*.ino.elf
*.ino.map
firmware/build/
simulation/build/
simulation/wokwi/build/

# --- Runtime Data, Backups & Temp Files ---
backend/data/*.backup.json
backend/data/*.tmp
*.tmp
*.temp

# --- Logs & Debug Outputs ---
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# --- Testing & Code Coverage ---
coverage/
*.lcov
.nyc_output/

# --- IDEs & Code Editors ---
.vscode/
!.vscode/extensions.json
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
*.swo
*.swn
*~

# --- Operating System Files ---
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini

# --- Python & Report Temp Files ---
__pycache__/
*.py[cod]
*$py.class
scratch/

